# --- MongoDB ---
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=BrowseAI
MONGO_DB_NAME=browse_ai
MONGO_COLLECTION=products

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=products

# --- API ---
# Comma-separated allowed origins for browser calls, or * for any.
CORS_ORIGINS=*

# --- Models (all free/local, downloaded from Hugging Face on first run) ---
# Defaults were picked by bench/ on a real catalog sample. Index
# (vectorize.py --recreate) and serve with the SAME models — the API refuses
# to start on a vector-dimension mismatch.
# TEXT_EMBED_MODEL=BAAI/bge-small-en-v1.5                 # 384d (mixedbread-ai/mxbai-embed-large-v1 measured no better)
# CLIP_MODEL=hf-hub:Marqo/marqo-fashionSigLIP            # 768d; light: clip-ViT-B-32 (512d)
# RERANK_MODEL=mixedbread-ai/mxbai-rerank-base-v1         # light: cross-encoder/ms-marco-MiniLM-L-6-v2
# EMBED_DEVICE=mps                                         # auto-detected: mps > cuda > cpu
# EMBED_DTYPE=float32                                      # force fp32 (default: fp16 weights kept on mps/cuda)
